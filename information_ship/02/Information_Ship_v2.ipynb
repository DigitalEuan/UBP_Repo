    "## 2. GEOMETRIC COMPASS: Leech Lattice Shell Mapping\n",
    "\n",
    "### 2.1 Shell Densities (Critical Fix: norm² Convention)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ============================================================================\n",
    "# CRITICAL FIX 1.1: Shell Convention - Use norm² (not norm)\n",
    "# ============================================================================\n",
    "\n",
    "class LeechShellGeometry:\n",
    "    \"\"\"\n",
    "    Leech lattice (Λ₂₄) shell geometry for mass generation.\n",
    "    \n",
    "    **CRITICAL FIX:** Uses norm² convention explicitly.\n",
    "    - electron: norm² = 4 (not 2)\n",
    "    - muon: norm² = 6 (not 4)\n",
    "    - tau: norm² = 8 (not 6)\n",
    "    \n",
    "    Shell densities from Conway & Sloane (1988).\n",
    "    \"\"\"\n",
    "    \n",
    "    def __init__(self):\n",
    "        # Shell map: lepton → norm² (EXPLICIT CONVENTION)\n",
    "        self.shell_map = {\n",
    "            'electron': 4,  # norm² = 4\n",
    "            'muon': 6,      # norm² = 6\n",
    "            'tau': 8        # norm² = 8\n",
    "        }\n",
    "        \n",
    "        # Shell densities (exact values from Leech lattice theory)\n",
    "        self.shell_densities = {\n",
    "            0: 1,              # Origin\n",
    "            2: 196560,         # First non-trivial shell\n",
    "            4: 16773120,       # Second shell (electron)\n",
    "            6: 398034000,      # Third shell (muon)\n",
    "            8: 4629381120      # Fourth shell (tau)\n",
    "        }\n",
    "        \n",
    "        # Monster group correction (derived, not fitted)\n",
    "        self.monster_correction = 196883 / 196560  # ≈ 1.001645\n",
    "        \n",
    "        print(\"=\"*70)\n",
    "        print(\"LEECH LATTICE SHELL GEOMETRY (norm² CONVENTION)\")\n",
    "        print(\"=\"*70)\n",
    "        print(f\"\\nShell Mapping (lepton → norm²):\")\n",
    "        for lepton, norm_sq in self.shell_map.items():\n",
    "            n_shell = self.shell_densities[norm_sq]\n",
    "            print(f\"  {lepton:<10} → norm² = {norm_sq}, n_shell = {n_shell:,}\")\n",
    "        \n",
    "        print(f\"\\nShell Density Ratios:\")\n",
    "        print(f\"  n₆/n₄ = {self.shell_densities[6] / self.shell_densities[4]:.2f}\")\n",
    "        print(f\"  n₈/n₆ = {self.shell_densities[8] / self.shell_densities[6]:.2f}\")\n",
    "        \n",
    "        print(f\"\\nMonster Group Correction: {self.monster_correction:.6f}\")\n",
    "        print(f\"  (196883 / 196560 = symmetry leakage factor)\")\n",
    "        print(\"=\"*70)\n",
    "    \n",
    "    def get_norm_squared(self, lepton: str) -> int:\n",
    "        \"\"\"Get norm² for a given lepton.\"\"\"\n",
    "        return self.shell_map[lepton]\n",
    "    \n",
    "    def get_shell_density(self, norm_squared: int) -> int:\n",
    "        \"\"\"Get shell density for a given norm².\"\"\"\n",
    "        return self.shell_densities[norm_squared]\n",
    "    \n",
    "    def predict_mass_ratio(self, lepton: str, reference: str = 'electron') -> float:\n",
    "        \"\"\"\n",
    "        Predict mass ratio using shell geometry.\n",
    "        \n",
    "        Formula: m_lepton / m_ref ≈ Y_INVERSE^((norm²_lepton - norm²_ref) / 2)\n",
    "        \n",
    "        Args:\n",
    "            lepton: Target lepton ('muon' or 'tau')\n",
    "            reference: Reference lepton (default: 'electron')\n",
    "        \n",
    "        Returns:\n",
    "            Predicted mass ratio\n",
    "        \"\"\"\n",
    "        norm_sq_lepton = self.get_norm_squared(lepton)\n",
    "        norm_sq_ref = self.get_norm_squared(reference)\n",
    "        \n",
    "        # Basic prediction (without corrections)\n",
    "        exponent = (norm_sq_lepton - norm_sq_ref) / 2.0\n",
    "        ratio = Y_INVERSE ** exponent\n",
    "        \n",
    "        # Apply Monster correction\n",
    "        ratio *= self.monster_correction\n",
    "        \n",
    "        return ratio\n",
    "\n",
    "\n",
    "# Initialize geometry\n",
    "leech_geometry = LeechShellGeometry()\n",
    "\n",
    "# Test predictions\n",
    "print(f\"\\nMass Ratio Predictions (Basic Model):\")\n",
    "m_muon_over_m_e_pred = leech_geometry.predict_mass_ratio('muon', 'electron')\n",
    "m_tau_over_m_e_pred = leech_geometry.predict_mass_ratio('tau', 'electron')\n",
    "\n",
    "# Experimental values\n",
    "m_muon_over_m_e_exp = M_MUON / M_ELECTRON\n",
    "m_tau_over_m_e_exp = M_TAU / M_ELECTRON\n",
    "\n",
    "print(f\"  m_μ / m_e: predicted = {m_muon_over_m_e_pred:.2f}, experimental = {m_muon_over_m_e_exp:.2f}\")\n",
    "print(f\"  m_τ / m_e: predicted = {m_tau_over_m_e_pred:.2f}, experimental = {m_tau_over_m_e_exp:.2f}\")\n",
    "\n",
    "error_muon = abs(m_muon_over_m_e_pred - m_muon_over_m_e_exp) / m_muon_over_m_e_exp * 100\n",
    "error_tau = abs(m_tau_over_m_e_pred - m_tau_over_m_e_exp) / m_tau_over_m_e_exp * 100\n",
    "\n",
    "print(f\"\\nRelative Errors:\")\n",
    "print(f\"  Muon: {error_muon:.2f}%\")\n",
    "print(f\"  Tau: {error_tau:.2f}%\")\n",
    "print(f\"\\n⚠ Note: Large tau error indicates need for δ mixing parameter\")"
   ]
