\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textbf  {UBP Discovery Pipeline Schematic.} Five-stage workflow from ChEMBL data loading through FDA classification. SMILES strings are hashed to 24-bit seeds, encoded as Golay G24 codewords, and evaluated via docking distance (Hamming complementarity) and syndrome weight (error-correction capacity). Toxicity filtering removes candidates with bit-mask violations.}}{16}{figure.caption.6}\protected@file@percent }
\newlabel{fig:pipeline}{{1}{16}{\textbf {UBP Discovery Pipeline Schematic.} Five-stage workflow from ChEMBL data loading through FDA classification. SMILES strings are hashed to 24-bit seeds, encoded as Golay G24 codewords, and evaluated via docking distance (Hamming complementarity) and syndrome weight (error-correction capacity). Toxicity filtering removes candidates with bit-mask violations}{figure.caption.6}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {FDA Classification Distribution.} Bar chart showing the distribution of 50 classified candidates across three FDA tiers. Zero Class I (Breakthrough Therapy) candidates were identified, seven Class II (Priority Review) candidates met dual thresholds, and 43 Class III (Standard Review) candidates remained.}}{16}{figure.caption.7}\protected@file@percent }
\newlabel{fig:fda_distribution}{{2}{16}{\textbf {FDA Classification Distribution.} Bar chart showing the distribution of 50 classified candidates across three FDA tiers. Zero Class I (Breakthrough Therapy) candidates were identified, seven Class II (Priority Review) candidates met dual thresholds, and 43 Class III (Standard Review) candidates remained}{figure.caption.7}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textbf  {Docking Distance Distribution.} Histogram of docking distances for 198 non-toxic candidates (mean = 7.78, range = [2, 24]). Clustering at specific integer values suggests discrete basins in chemical space.}}{17}{figure.caption.8}\protected@file@percent }
\newlabel{fig:docking_histogram}{{3}{17}{\textbf {Docking Distance Distribution.} Histogram of docking distances for 198 non-toxic candidates (mean = 7.78, range = [2, 24]). Clustering at specific integer values suggests discrete basins in chemical space}{figure.caption.8}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces \textbf  {Complementarity-Stability Tradeoff Surface.} Heatmap showing candidate distribution across docking distance ($d_{\text  {dock}}$) and syndrome weight ($w_{\text  {syndrome}}$) dimensions. The upper-left Class I region ($d_{\text  {dock}} \leq 2$ AND $w_{\text  {syndrome}} \leq 3$) remains unpopulated, confirming the tradeoff. Class II candidates occupy the Pareto frontier.}}{17}{figure.caption.9}\protected@file@percent }
\newlabel{fig:heatmap}{{4}{17}{\textbf {Complementarity-Stability Tradeoff Surface.} Heatmap showing candidate distribution across docking distance ($d_{\text {dock}}$) and syndrome weight ($w_{\text {syndrome}}$) dimensions. The upper-left Class I region ($d_{\text {dock}} \leq 2$ AND $w_{\text {syndrome}} \leq 3$) remains unpopulated, confirming the tradeoff. Class II candidates occupy the Pareto frontier}{figure.caption.9}{}}
