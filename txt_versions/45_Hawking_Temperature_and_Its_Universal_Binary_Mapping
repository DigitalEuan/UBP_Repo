Python Script
#!/usr/bin/env python3
"""
compute_th_vs_ubp.py

Compute T_GR and T_UBP across a mass range, produce plots and a sample table.
Requirements: numpy, matplotlib, scipy
Run: python compute_th_vs_ubp.py
"""

import numpy as np
import matplotlib.pyplot as plt
from scipy.constants import hbar, c, G, k as kB

# Physical constants
M_sun = 1.98847e30  # kg

# Define functions
def kappa_gr(M):
    return c**4 / (4 * G * M)

def T_gr(M):
    return hbar * c**3 / (8 * np.pi * G * M * kB)

# UBP mapping: choose S_UBP(M) = alpha * (M / M_sun)
# Calibrate alpha so that kappa_ubp(M_sun) = kappa_gr(M_sun)
K = c**4 / (4 * G)

# If S_UBP = alpha * (M/M_sun), then kappa_ubp = K * alpha * (M/M_sun)
# At M = M_sun we require K * alpha * 1 = kappa_gr(M_sun) => alpha = kappa_gr(M_sun) / K
alpha = kappa_gr(M_sun) / K

def S_ubp(M):
    return alpha * (M / M_sun)

def kappa_ubp(M):
    return K * S_ubp(M)

def T_ubp(M):
    return hbar * kappa_ubp(M) / (2 * np.pi * c * kB)

# Mass sweep
Ms = np.logspace(10, 30, 401)  # kg
Tg = T_gr(Ms)
Tu = T_ubp(Ms)

# Fractional residual
res = np.abs(Tu - Tg) / Tg

# Plot: log-log comparison
plt.figure(figsize=(8,5))
plt.loglog(Ms, Tg, label=r'$T_{GR}$')
plt.loglog(Ms, Tu, '--', label=r'$T_{UBP}$')
plt.xlabel('Mass (kg)')
plt.ylabel('Temperature (K)')
plt.title('Hawking Temperature: GR vs UBP (calibrated at $M_\odot$)')
plt.legend()
plt.grid(True, which='both', ls=':', lw=0.4)
plt.tight_layout()
plt.savefig('th_loglog.png', dpi=300)
plt.close()

# Plot: residuals
plt.figure(figsize=(8,4))
plt.loglog(Ms, res)
plt.xlabel('Mass (kg)')
plt.ylabel('Fractional residual')
plt.title('Fractional residual |T_UBP - T_GR| / T_GR')
plt.grid(True, which='both', ls=':', lw=0.4)
plt.tight_layout()
plt.savefig('th_residuals.png', dpi=300)
plt.close()

# Print sample table
sample_masses = [1e12, 1e20, 1e30, M_sun]
print('{:>12s} {:>16s} {:>16s} {:>12s}'.format('Mass(kg)', 'T_GR (K)', 'T_UBP (K)', 'res'))
for m in sample_masses:
    tg = T_gr(m)
    tu = T_ubp(m)
    r = abs(tu - tg) / tg
    print(f'{m:12.3e} {tg:16.6e} {tu:16.6e} {r:12.6e}')

print('\nPlots saved: th_loglog.png, th_residuals.png')



